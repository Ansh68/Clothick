# Server port (default 5000)
PORT=5000

# MongoDB connection string (required)
# Local: mongodb://localhost:27017/tulos
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/tulos
MONGODB_URI=mongodb://localhost:27017/tulos

# JWT secret for signing auth tokens (required)
# Use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Razorpay (required for payments in India)
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Frontend URL for CORS and redirects (required)
# Local dev: http://localhost:5173
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173
